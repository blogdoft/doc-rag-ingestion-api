{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Information"
    }
  },
  "AllowedHosts": "*",
  "Garage": {
    "Region": "garage",
    "Bucket": "doc-rag-originals",
    "ForcePathStyle": true,
    "PartSizeMiB": 8
  },
  "Upload": {
    "MaxBytes": 1073741824,
    "AllowedContentTypes": [
      "application/pdf",
      "text/markdown",
      "text/plain",
      "text/html",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
    ],
    "MaxConcurrentUploads": 3,
    "LeaseMinutes": 30,
    "IdempotencyTtlHours": 24
  },
  "Outbox": {
    "BatchSize": 100,
    "PollingSeconds": 5,
    "MaxAttemptsBeforeAlert": 20,
    "LeaseSeconds": 120
  },
  "Reconciliation": {
    "IntervalSeconds": 300,
    "MultipartMaxAgeMinutes": 120,
    "CleanupBatchSize": 200
  },
  "Observability": {
    "OpenTelemetry": {
      "UseTracingExporter": "DoNotUse",
      "UseMetricsExporter": "DoNotUse",
      "UseLogExporter": "DoNotUse"
    },
    "OtlpExporterOptions": {
      "Endpoint": "http://localhost:4317",
      "Protocol": "Grpc"
    }
  },
  "Kafka": {
    "BootstrapServers": "",
    "TopicDocumentUploaded": "doc-rag.documents.uploaded.v1",
    "SecurityProtocol": "Plaintext",
    "MessageTimeoutMs": 30000,
    "RequestTimeoutMs": 10000
  }
}