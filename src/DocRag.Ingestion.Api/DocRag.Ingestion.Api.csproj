<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Required for Swashbuckle to pick up XML doc comments as operation/schema descriptions. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Version>0.0.0-dev</Version>
    <UserSecretsId>cac61a95-5e62-44bd-9dd2-ce93590761a1</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BlogDoFT.Libs.Api.OpenTelemetry" Version="10.1.1" />
    <PackageReference Include="BlogDoFT.Libs.WarmUp" Version="10.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Npgsql.OpenTelemetry" Version="10.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="10.2.3" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.2.3" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DocRag.Ingestion.Application\DocRag.Ingestion.Application.csproj" />
    <ProjectReference Include="..\DocRag.Ingestion.Infrastructure\DocRag.Ingestion.Infrastructure.csproj" />
  </ItemGroup>

</Project>
