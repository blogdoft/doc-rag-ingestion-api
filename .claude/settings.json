{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": [
            "Edit(*)",
            "Write(*)",
            "NotebookEdit(*)",
            "Bash",
            "WebFetch(domain:*)",
            "WebSearch",
            "mcp__*",
            "mcp_ide_*",
            "mcp_chrome-devtools_*",
            "mcp_claude-in-chrome_*",
            "mcp_playwright_*",
            "mcp_reddit-mcp-server_search_reddit",
            "mcp_reddit-mcp-server_get_post_details",
            "mcp_tavily-web-search_tavily_search",
            "mcp_tavily-web-search_tavily_extract",
            "WebFetch(domain:raw.githubusercontent.com)",
            "WebFetch(domain:docs.anthropic.com)",
            "WebFetch(domain:support.claude.com)",
            "WebFetch(domain:github.com)",
            "WebFetch(domain:api.github.com)",
            "WebFetch(domain:json.schemastore.org)",
            "WebFetch(domain:claudelog.com)",
            "WebFetch(domain:forgejo.home.arpa/sauron)"
        ],
        "deny": [],
        "ask": [
            "Bash(rm *)",
            "Bash(rmdir *)",
            "Bash(shred *)",
            "Bash(unlink *)",
            "Bash(dd *)",
            "Bash(mkfs *)",
            "Bash(fdisk *)",
            "Bash(chmod *)",
            "Bash(chown *)",
            "Bash(git *)",
            "Bash(gh *)",
            "Bash(npm *)",
            "Bash(pip *)",
            "Bash(pip3 *)",
            "Bash(yarn *)",
            "Bash(pnpm *)",
            "Bash(docker *)",
            "Bash(kubectl *)",
            "Bash(firebase *)",
            "Bash(gcloud *)",
            "Bash(wget *)",
            "Bash(kill *)",
            "Bash(killall *)",
            "Bash(pkill *)"
        ]
    },
    "spinnerVerbs": {
        "mode": "replace",
        "verbs": [
            "Já bebeu água?",
            "Vai dar um beijo no Carlinhos enquanto eu faço aqui",
            "Vai dar um beijo na Ana enquanto eu faço aqui",
            "Calma!",
            "Tô pensando ainda.",
            "Nossa! Tem coisa demais aqui",
            "Deixa eu pensar",
            "Vai buscar um café, que eu vou vendo aqui",
            "Deixei um trem pra trás. Peraí",
            "Quase lá",
            "Pensando",
            "Acho que isso vai longe, hein",
            "Mais um pouco e eu termino. Cê calma!",
            "Cê calma",
            "Pra quê tanta pressa? Se o mundo não foi feito em sete dias"
        ]
    },
    "plansDirectory": "./.specs",
    "outputStyle": "Explanatory",
    "spinnerTipsEnabled": true,
    "respectGitignore": true,
    "env": {
        "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "80"
    },
    "enableAllProjectMcpServers": true,
    "disableAllHooks": false
}